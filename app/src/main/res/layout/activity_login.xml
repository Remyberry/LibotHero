<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".LoginActivity"
    android:background="#FFAD00">

    <LinearLayout
        android:layout_width="350dp"
        android:layout_height="620dp"
        android:layout_centerInParent="true"
        android:background="@drawable/login_panel_bg"
        android:elevation="15dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="185dp"
            android:background="@drawable/header_panelbg"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/qwe"
                android:text="@string/libothero"
                android:textColor="#000000"
                android:textSize="34sp" />

            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/libothero"
                app:tint="@color/black" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/Username"
                android:layout_width="316dp"
                android:layout_height="45dp"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/round_crnr"
                android:hint="Username"
                android:paddingStart="10dp" />

            <!-- Password input -->
            <EditText
                android:id="@+id/Password"
                android:layout_width="316dp"
                android:layout_height="45dp"
                android:layout_gravity="center"
                android:background="@drawable/round_crnr"
                android:hint="Password"
                android:inputType="textPassword"
                android:paddingStart="10dp" />

            <!-- Forgot password -->
            <TextView
                android:id="@+id/textViewForgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="17dp"
                android:layout_marginTop="8dp"
                android:paddingStart="10dp"
                android:text="Forgot Password?"
                android:textColor="#03A9F4" />

            <!-- Login button -->
            <Button
                android:id="@+id/buttonLogin"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/btn_yo_bg"
                android:text="@string/login"
                android:textColor="#FFFFFF" />

            <!-- Continue as guest button -->
            <Button
                android:id="@+id/buttonContinueAsGuest"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="8dp"
                android:background="@drawable/btn_yo_outline"
                android:text="@string/continue_as_guest"
                android:textColor="#D68D40" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center|top"
            android:layout_marginTop="40dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:text="New here?" />

            <TextView
                android:id="@+id/toSignup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" Sign me up"
                android:textColor="#D68D40" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>