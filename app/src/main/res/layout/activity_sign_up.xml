<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFAD00"
    tools:context=".SignUpActivity">

    <LinearLayout
        android:layout_width="340dp"
        android:layout_height="660dp"
        android:layout_centerInParent="true"
        android:background="@drawable/signuppanelbg"
        android:elevation="15dp"
        android:orientation="vertical">

        <!-- Username input -->

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_gravity="center_vertical"
            android:layout_marginBottom="10dp"
            android:background="@drawable/signupbgheader">

            <ImageView
                android:id="@+id/imageView4"
                android:layout_width="68dp"
                android:layout_height="76dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="60dp"
                android:layout_toEndOf="@id/textView2"
                android:visibility="visible"
                app:srcCompat="@drawable/libothero"
                app:tint="@color/black" />

            <TextView
                android:id="@+id/textView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="60dp"
                android:fontFamily="@font/gogogow"
                android:text="@string/libothero"
                android:textAlignment="center"
                android:textAppearance="@style/TextAppearance.AppCompat.Display2"
                android:textColor="#000000"
                android:textSize="34sp"
                android:visibility="visible" />

        </RelativeLayout>

        <EditText
            android:id="@+id/email"
            android:layout_width="300dp"
            android:layout_height="45dp"
            android:layout_gravity="center"
            android:layout_margin="5dp"
            android:background="@drawable/round_crnr"
            android:hint="Email"
            android:paddingStart="10dp" />

        <EditText
            android:id="@+id/username"
            android:layout_width="300dp"
            android:layout_height="45dp"
            android:layout_gravity="center"
            android:layout_margin="5dp"
            android:background="@drawable/round_crnr"
            android:hint="Username"
            android:paddingStart="10dp" />

        <EditText
            android:id="@+id/phone"
            android:layout_width="300dp"
            android:layout_height="45dp"
            android:layout_gravity="center"
            android:layout_margin="5dp"
            android:background="@drawable/round_crnr"
            android:hint="Mobile Phone"
            android:inputType="phone"
            android:paddingStart="10dp" />

        <EditText
            android:id="@+id/bday"
            android:layout_width="300dp"
            android:layout_height="45dp"
            android:layout_gravity="center"
            android:layout_margin="5dp"
            android:background="@drawable/round_crnr"
            android:hint="Birthdate"
            android:inputType="datetime|date"
            android:paddingStart="10dp" />

        <!-- Password input -->
        <EditText
            android:id="@+id/password"
            android:layout_width="300dp"
            android:layout_height="45dp"
            android:layout_gravity="center"
            android:layout_margin="5dp"
            android:background="@drawable/round_crnr"
            android:hint="Password"
            android:inputType="textPassword"
            android:paddingStart="10dp" />

        <EditText
            android:id="@+id/confirmpass"
            android:layout_width="300dp"
            android:layout_height="45dp"
            android:layout_gravity="center"
            android:layout_margin="5dp"
            android:background="@drawable/round_crnr"
            android:hint="Confirm Password"
            android:inputType="textPassword"
            android:paddingStart="10dp" />


        <!-- Terms and Conditions-->
        <CheckBox
            android:id="@+id/eula"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="5dp"
            android:text="Agree To Terms Conditions"
            android:textColor="#03A9F4" />


        <!-- Login button -->
        <Button
            android:id="@+id/SignMeUp"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/btn_yo_bg"
            android:text="Sign Me Up"
            android:textColor="#FFFFFF" />

        <!-- Continue as guest button -->

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/nevamind"
                android:layout_width="wrap_content"
                android:layout_height="25dp"
                android:layout_centerVertical="true"
                android:gravity="center"
                android:text="Nevamind, I'll"
                android:textAlignment="center"
                android:textColor="#000000" />

            <TextView
                android:id="@+id/toLogin"
                android:layout_width="wrap_content"
                android:layout_height="25dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="3dp"
                android:layout_toEndOf="@+id/nevamind"
                android:elevation="10dp"
                android:gravity="center"
                android:text="@string/login"
                android:textAlignment="center"
                android:textColor="#D68D40"
                android:textStyle="bold" />
        </RelativeLayout>


    </LinearLayout>

</RelativeLayout>